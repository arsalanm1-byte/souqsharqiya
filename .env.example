# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (or legacy "anon") key. Safe in the browser: RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret (or legacy "service_role") key. Server only: used by cron jobs and
# chat email alerts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public address of the site, used in emails, sign-in links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (resend.com) API key for chat and saved-search emails. Optional in
# development: without it emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Souq Sharqiya <no-reply@souqsharqiya.com>"

# Any long random string. Vercel Cron sends it to the /api/cron/* routes.
CRON_SECRET=

# Social sign-in buttons to show, comma-separated: google, apple. Each must
# also be enabled in Supabase → Authentication → Providers.
NEXT_PUBLIC_AUTH_PROVIDERS=google
